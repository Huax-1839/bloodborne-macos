      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Mods"
          }
        }
      }
    },
    "Not supported: mods that replace eboot.bin or system files, and mods that work by injecting a DLL. Archives other than ZIP (7z, RAR) have to be unpacked first, with an app like The Unarchiver." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht unterstützt: Mods, die die eboot.bin oder Systemdateien ersetzen, und Mods, die per DLL-Injektion arbeiten. Andere Archive als ZIP (7z, RAR) musst du vorher mit einer App wie The Unarchiver entpacken."
          }
        }
      }
    },
