            "state" : "translated",
            "value" : "umbenennen…"
          }
        }
      }
    },
    "Several switched-on mods replace these files. The mod marked ✦ is the one that wins; change the order to change that." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere eingeschaltete Mods ersetzen diese Dateien. Die mit ✦ markierte gewinnt; ändere die Reihenfolge, um das zu ändern."
          }
        }
      }
    },
    "show in Finder" : {
      "extractionState" : "manual",
