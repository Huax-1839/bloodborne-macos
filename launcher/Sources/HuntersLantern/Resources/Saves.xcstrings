    },
    "Choose a .lanternsave file with a single character." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine .lanternsave-Datei mit einem einzelnen Charakter."
