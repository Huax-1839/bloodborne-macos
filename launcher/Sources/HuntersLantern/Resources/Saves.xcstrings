    },
    "Character “%@” imported into slot %lld. The state before is in an automatic backup." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charakter „%@“ in Slot %lld importiert. Der Stand davor liegt in einem automatischen Backup."
