    "Choose a .lanternsave file with a whole save." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine .lanternsave-Datei mit einem ganzen Spielstand."
