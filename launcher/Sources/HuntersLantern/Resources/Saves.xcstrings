    "The file was made on %@ and holds no characters. The current save is replaced, after an automatic backup of it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wurde am %@ erstellt und enthält keine Charaktere. Der aktuelle Spielstand wird ersetzt, nachdem er automatisch gesichert wurde."
          }
        }
      }
    },
    "The file was made on %@ and holds: %@. The current save is replaced, after an automatic backup of it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
