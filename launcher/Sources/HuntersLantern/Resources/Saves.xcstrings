    },
    "Choose the bbport folder (the one with macos/user inside), or a folder that holds savedata." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den bbport-Ordner (den mit macos/user darin) oder einen Ordner, der savedata enthält."
          }
        }
      }
    },
    "Copy the saves, the settings (bbport.ini) and, if you like, the shader cache from a bbport folder (macos/user and macos/bbport.ini) into the launcher. Your current saves are backed up first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiere die Spielstände, die Einstellungen (bbport.ini) und, wenn du magst, den Shader-Cache aus einem bbport-Ordner (macos/user und macos/bbport.ini) in den Launcher. Deine aktuellen Spielstände werden vorher gesichert."
          }
        }
      }
    },
