    "Choose the base game's .pkg and the full 1.09 update's .pkg. A delta update does not work.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die .pkg des Basisspiels und die .pkg des vollständigen 1.09-Updates. Ein Delta-Update funktioniert nicht."
          }
        }
      }
    },
    "Choose the folder of the base game and the folder of the 1.09 update. The update's files replace the base game's; both folders stay unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ordner des Basisspiels und den Ordner des 1.09-Updates. Die Dateien des Updates ersetzen die des Basisspiels; beide Ordner bleiben unverändert."
          }
        }
