          }
        }
      }
    },
    "Use this if you have the base game and the 1.09 update as .pkg files. An external PKG tool unpacks them; the launcher then merges the result.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze dies, wenn du das Basisspiel und das 1.09-Update als .pkg-Dateien hast. Ein externes PKG-Werkzeug entpackt sie; der Launcher führt das Ergebnis anschließend zusammen."
