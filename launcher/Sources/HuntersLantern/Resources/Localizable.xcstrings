    "Automatic backups before each start, named snapshots, restoring and exporting or importing a save.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Sicherungen vor jedem Start, benannte Schnappschüsse, Wiederherstellen sowie Export und Import eines Spielstands."
          }
        }
      }
    },
    "Automatic: the upscaler preset decides the scene size. The upscaler can also be changed in the game's menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch: Die Voreinstellung des Upscalers bestimmt die Szenenauflösung. Der Upscaler lässt sich auch im Menü des Spiels ändern."
          }
        }
      }
    },
    "Backing up saves": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherstände werden gesichert"
          }
        }
      }
    },
