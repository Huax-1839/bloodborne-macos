{
  "sourceLanguage" : "en",
  "strings" : {
    "A system tool failed: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Systemwerkzeug ist fehlgeschlagen: %@"
          }
        }
      }
    },
    "Slot %lld does not exist: the game has ten slots." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slot %lld gibt es nicht: Das Spiel hat zehn Slots."
          }
        }
      }
    },
    "Slot %lld holds no character." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slot %lld enthält keinen Charakter."
          }
        }
      }
    },
    "The current save has no global file (userdata0010) yet, so a character cannot be placed into it. Start the game once and let it save, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktuelle Spielstand hat noch keine globale Datei (userdata0010), deshalb lässt sich kein Charakter hineinlegen. Starte das Spiel einmal und lass es speichern, dann versuch es erneut."
          }
        }
      }
    },
    "The file contains an unsafe entry (%@) and was not imported." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei enthält einen unsicheren Eintrag (%@) und wurde nicht importiert."
          }
        }
      }
    },
    "The file is for “%@”, which is not a Bloodborne version this launcher knows." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei gehört zu „%@“, einer Bloodborne-Version, die dieser Launcher nicht kennt."
          }
        }
      }
    },
    "The file is not laid out like a Hunter's Lantern save: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei ist nicht wie ein Hunter's-Lantern-Spielstand aufgebaut: %@"
          }
        }
      }
    },
    "The folder you chose is the launcher's own save folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gewählte Ordner ist der Spielstandordner des Launchers selbst."
          }
        }
      }
    },
    "There is no save to export yet. Start the game once first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt noch keinen Spielstand zum Exportieren. Starte zuerst einmal das Spiel."
          }
        }
      }
    },
    "This file holds a single character, not a whole save. Use “Import character into slot…” instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei enthält einen einzelnen Charakter, keinen ganzen Spielstand. Nimm stattdessen „Charakter in Slot importieren…“."
          }
        }
      }
    },
    "This file holds a whole save, not a single character. Use “Import save…” instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei enthält einen ganzen Spielstand, keinen einzelnen Charakter. Nimm stattdessen „Spielstand importieren…“."
          }
        }
      }
    },
    "This is not a Hunter's Lantern save file: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist keine Speicherdatei von Hunter's Lantern: %@"
          }
        }
      }
    },
    "This save file has format %lld, which this version of the launcher does not know. Update the launcher." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Speicherdatei hat das Format %lld, das diese Version des Launchers nicht kennt. Aktualisiere den Launcher."
          }
        }
      }
    },
    "manifest.json is missing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "manifest.json fehlt"
          }
        }
      }
    },
    "manifest.json is unreadable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "manifest.json ist nicht lesbar"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
